# Explicit configuration only. Never paste real credentials into source or traces.
# Copy to .env; CLI loads it using Node's loadEnvFile.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://codeplan.iquestlab.com/api/predict/converge.converge/v1
MODEL_NAME=IQuest-Q1
OPENAI_API_MODE=responses
# PI_RSI_* names remain supported and take precedence when nonempty.
# PI_RSI_PROVIDER defaults to iquest for a custom endpoint; override for another provider.
# Builtin example: PI_RSI_PROVIDER=anthropic, PI_RSI_MODEL=claude-sonnet-4-5,
# PI_RSI_API_KEY=<your key> (omit BASE_URL and API_MODE for a builtin model).
PI_RSI_TIMEOUT_MS=60000
PI_RSI_MAX_TURNS=8
# Evolver only; Worker retains its 2048-token model definition.
PI_RSI_EVOLVER_MAX_TOKENS=8192
