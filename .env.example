# Explicit configuration only. Never paste real credentials into source or traces.
# Copy to .env; CLI loads it using Node's loadEnvFile.
PI_RSI_PROVIDER=anthropic
PI_RSI_MODEL=claude-sonnet-4-5
PI_RSI_API_KEY=
# For a user-configured compatible endpoint, set both API and BASE_URL.
# PI_RSI_API=openai-responses
# PI_RSI_BASE_URL=https://your-configured-endpoint.example/v1
PI_RSI_TIMEOUT_MS=60000
PI_RSI_MAX_TURNS=8
